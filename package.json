{
  "name": "klugstore",
  "version": "0.1.0",
  "description": "SweetHome GT — Tienda en línea de decoración y hogar",
  "productName": "SweetHome GT",
  "author": "diegoalay <diego.alay@galileo.edu>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "dev": "quasar dev",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "catalog:apply-overlay": "node scripts/apply-admin-overlay-to-json.mjs",
    "catalog:export-sheets": "node scripts/export-catalog-to-csv.mjs",
    "migrate:firestore": "node scripts/migrate-to-firestore.mjs",
    "build": "npm run generate:sitemap && quasar build -m ssg",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview",
    "postinstall": "quasar prepare",
    "build:spa": "npm run generate:sitemap && quasar build",
    "test:watch": "vitest",
    "sync:instagram": "node scripts/sync-instagram.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-pro": "^7.3.1",
    "@quasar/extras": "^2.1.0",
    "@vue/devtools-api": "^8.2.1",
    "firebase": "^12.19.0",
    "pinia": "^4.0.3",
    "quasar": "^2.34.0",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.1",
    "@types/node": "^26.6.4",
    "@types/sortablejs": "^1.15.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "firebase-admin": "^14.5.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": "^30 || ^28 || ^26 || ^24 || ^22.22.0",
    "npm": ">= 6.13.4"
  }
}
