rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin = perfil en stores/sweethome/users/{uid} con role 0 y active true.
    // Los perfiles solo los escriben las Cloud Functions (functions/index.js), que
    // también son las únicas que crean cuentas (el registro público está deshabilitado).
    function adminProfilePath() {
      return /databases/$(database)/documents/stores/sweethome/users/$(request.auth.uid);
    }

    function isAdmin() {
      return request.auth != null
        && exists(adminProfilePath())
        && get(adminProfilePath()).data.role == 0
        && get(adminProfilePath()).data.active == true;
    }

    // Catálogo público: lectura abierta (debe ser indexable y visible sin login).
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin();

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Estado de integraciones (p. ej. lastSyncAt de Instagram): privado.
      match /integrations/{integrationId} {
        allow read, write: if isAdmin();
      }

      // Usuarios del admin: cada quien lee su propio perfil (para saber su rol al
      // iniciar sesión); los admins ven la lista. Escritura solo vía Cloud Functions.
      match /users/{userId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }

      // Posts de Instagram sincronizados para crear productos: privados.
      match /instagramPosts/{postId} {
        allow read, write: if isAdmin();
      }

      match /products/{productId} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create, update: if isAdmin()
          && request.resource.data.name is string
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.images is list;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
