rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null;
    }

    // Fotos de producto: lectura pública (se sirven en el catálogo); solo
    // admin sube/borra. En delete no hay request.resource, por eso va aparte
    // de las validaciones de tamaño/tipo.
    match /stores/{storeId}/products/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
